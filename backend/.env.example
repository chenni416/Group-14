# 複製成 .env 後填入；.env 不要 commit

APP_ENV=development
# 前端開發伺服器的網址（JSON 陣列）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5175"]

# 資料庫：本機使用 docker-compose 的 Postgres；雲端改填 Supabase 的連線字串
# （Supabase 後台 Project Settings → Database → Connection string，開頭改為 postgresql+psycopg://）
DATABASE_URL=postgresql+psycopg://taskline:taskline@localhost:5432/taskline

# 登入：Supabase Auth（GitHub 登入）
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# 檔案儲存：Supabase Storage（service role key 只能放在後端）
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# LLM：Anthropic API（在 Claude Console 建立，建議設定每月花費上限）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 背景工作
REDIS_URL=redis://localhost:6379/0

# GitHub App（同步 PR 狀態）
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
