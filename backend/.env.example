# 複製成 .env 後填入以下資訊

APP_ENV=development
# 前端開發伺服器的網址（JSON 陣列）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# 資料庫：團隊共用雲端 Supabase（只需要把 <資料庫密碼> 換成實際密碼；./setup.sh 會詢問）
# 一定要用 port 6543（Transaction pooler）：免費版全專案只有 15 條資料庫連線，
# 用 5432（Session pooler）時每個人的後端都會佔住連線，三、四個人同時開就會滿
DATABASE_URL=postgresql+psycopg://postgres.cbejwpojskqynykodlma:<資料庫密碼>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
# 遷移（alembic）用的連線字串，通常不用設：留空時會自動把上面的 6543 換成 5432
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.cbejwpojskqynykodlma:<資料庫密碼>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# 改用本機 Docker 的資料庫（docker compose up -d）時：
# DATABASE_URL=postgresql+psycopg://taskline:taskline@localhost:5433/taskline

# 登入：Supabase Auth（GitHub 登入）
# Project URL
SUPABASE_URL=https://cbejwpojskqynykodlma.supabase.co

# 檔案儲存：Supabase Storage（service role key 只能放在後端）
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# LLM：OpenAI API（AI 功能使用；在 platform.openai.com 建立金鑰，建議設定每月花費上限）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# 取樣溫度（0–2，越低越穩定）：結構化輸出（切 Story、拆 Task、指派、小助理）與純文字對話（Story 助理）
# 使用不支援 temperature 的模型時設為空值
OPENAI_TEMPERATURE=0.2
OPENAI_TEXT_TEMPERATURE=0.5

# LLM：Anthropic API（舊客戶端，保留備用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 背景工作
REDIS_URL=redis://localhost:6379/0

# ---------- GitHub App（讀取 repo 的 commit、PR、CI）----------
# GitHub → Settings → Developer settings → GitHub Apps → 你建立的 App
# App 設定頁上方的 App ID（數字）
GITHUB_APP_ID=5871347
# App 的網址名稱：github.com/apps/<這一段>
GITHUB_APP_SLUG=taskline14
# 同一頁的 Client ID（Iv 開頭）
GITHUB_CLIENT_ID=Iv23li9eTFLmZeon9tzs
# Generate a new client secret 產生的值（只會顯示一次）
GITHUB_CLIENT_SECRET=
# Generate a private key 下載的 .pem 檔「完整路徑」，建議放在 repo 以外，例如 /Users/<你>/.taskline/github-app.pem
GITHUB_PRIVATE_KEY_PATH=
# webhook 目前未啟用，之後開啟時再填
GITHUB_WEBHOOK_SECRET=

# 假資料是否預先建好規劃中的 Sprint 3；設 false 就從畫面的「建立 Sprint」開始（重新啟動後端才生效）
# SEED_PLANNING_SPRINT=false
