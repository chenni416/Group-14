# 複製成 .env 後填入；.env 不要 commit

APP_ENV=development
# 前端開發伺服器的網址（JSON 陣列）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5175"]

# 資料庫：本機使用 docker-compose 的 Postgres；雲端改填 Supabase 的連線字串
# （Supabase 後台 Project Settings → Database → Connection string，開頭改為 postgresql+psycopg://）
DATABASE_URL=postgresql+psycopg://taskline:taskline@localhost:5432/taskline

# 登入：Supabase Auth（GitHub 登入）
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# 檔案儲存：Supabase Storage（service role key 只能放在後端）
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# LLM：OpenAI API（AI 功能使用；在 platform.openai.com 建立金鑰，建議設定每月花費上限）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# 取樣溫度（0–2，越低越穩定）：結構化輸出（切 Story、拆 Task、指派、小助理）與純文字對話（Story 助理）
# 使用不支援 temperature 的模型時設為空值
OPENAI_TEMPERATURE=0.2
OPENAI_TEXT_TEMPERATURE=0.5

# LLM：Anthropic API（舊客戶端，保留備用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 背景工作
REDIS_URL=redis://localhost:6379/0

# GitHub App（同步 PR 狀態）
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# 假資料是否預先建好規劃中的 Sprint 3；設 false 就從畫面的「建立 Sprint」開始（重新啟動後端才生效）
# SEED_PLANNING_SPRINT=false
