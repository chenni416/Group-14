# 複製成 .env 後填入以下資訊

APP_ENV=development
# 前端開發伺服器的網址（JSON 陣列）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# 資料庫：團隊共用雲端 Supabase
DATABASE_URL=postgresql+psycopg://postgres.<專案代號>:<資料庫密碼>@aws-0-<地區>.pooler.supabase.com:5432/postgres?sslmode=require
# 改用本機 Docker 的資料庫（docker compose up -d）時：
# DATABASE_URL=postgresql+psycopg://taskline:taskline@localhost:5432/taskline

# 登入：Supabase Auth（GitHub 登入）
# Project URL
SUPABASE_URL=

# 檔案儲存：Supabase Storage（service role key 只能放在後端）
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# LLM：OpenAI API（AI 功能使用；在 platform.openai.com 建立金鑰，建議設定每月花費上限）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# 取樣溫度（0–2，越低越穩定）：結構化輸出（切 Story、拆 Task、指派、小助理）與純文字對話（Story 助理）
# 使用不支援 temperature 的模型時設為空值
OPENAI_TEMPERATURE=0.2
OPENAI_TEXT_TEMPERATURE=0.5

# LLM：Anthropic API（舊客戶端，保留備用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 背景工作
REDIS_URL=redis://localhost:6379/0

# GitHub App（同步 PR 狀態）
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
