# 複製成 .env 後填入以下資訊

APP_ENV=development
# 前端開發伺服器的網址（JSON 陣列）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# 資料庫：團隊共用雲端 Supabase（只需要把 <資料庫密碼> 換成實際密碼；./setup.sh 會詢問）
DATABASE_URL=postgresql+psycopg://postgres.cbejwpojskqynykodlma:<資料庫密碼>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# 改用本機 Docker 的資料庫（docker compose up -d）時：
# DATABASE_URL=postgresql+psycopg://taskline:taskline@localhost:5432/taskline

# 登入：Supabase Auth（GitHub 登入）
# Project URL
SUPABASE_URL=https://cbejwpojskqynykodlma.supabase.co

# 檔案儲存：Supabase Storage（service role key 只能放在後端）
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# LLM：Anthropic API（在 Claude Console 建立，建議設定每月花費上限）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 背景工作
REDIS_URL=redis://localhost:6379/0

# ---------- GitHub App（讀取 repo 的 commit、PR、CI）----------
# GitHub → Settings → Developer settings → GitHub Apps → 你建立的 App
# App 設定頁上方的 App ID（數字）
GITHUB_APP_ID=5871347
# App 的網址名稱：github.com/apps/<這一段>
GITHUB_APP_SLUG=taskline14
# 同一頁的 Client ID（Iv 開頭）
GITHUB_CLIENT_ID=Iv23li9eTFLmZeon9tzs
# Generate a new client secret 產生的值（只會顯示一次）
GITHUB_CLIENT_SECRET=
# Generate a private key 下載的 .pem 檔「完整路徑」，建議放在 repo 以外，例如 /Users/<你>/.taskline/github-app.pem
GITHUB_PRIVATE_KEY_PATH=
# webhook 目前未啟用，之後開啟時再填
GITHUB_WEBHOOK_SECRET=
